{
  "name": "vela-media-player",
  "productName": "Vela",
  "version": "1.0.0",
  "description": "Minimal, cinematic Windows 11 desktop media player powered by libmpv, FFmpeg, libass, and libplacebo.",
  "author": "Vela",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.vela.mediaplayer",
    "productName": "Vela",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "LICENSING.md",
      "PLAYBACK_TESTING_CHECKLIST.md"
    ],
    "extraResources": [
      {
        "from": "resources/mpv",
        "to": "mpv",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
